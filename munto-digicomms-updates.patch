+
+/* --- cookie banner --- */
+.cookie-banner{position:fixed;left:0;right:0;bottom:0;z-index:50;background:var(--ink);color:#fff;padding:14px 20px;display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;font-size:.88rem}
+.cookie-banner a{color:#ffb27a}
+.cookie-actions{display:flex;gap:8px;flex-shrink:0}
+
+/* --- client logo strip --- */
+.logos{padding:28px 0;border-bottom:1px solid var(--line)}
+.logos-label{margin:0 0 14px;color:var(--muted);font-size:.82rem;text-transform:uppercase;letter-spacing:.08em;text-align:center}
+.logos-row{display:flex;gap:28px;flex-wrap:wrap;justify-content:center}
+.logo-slot{color:var(--muted);border:1px dashed var(--line);border-radius:8px;padding:10px 18px;font-size:.85rem}
+
+/* --- case studies / results --- */
+.results .card.case{display:flex;flex-direction:column;gap:8px}
+.metric{font-family:"Trebuchet MS",sans-serif;font-weight:800;font-size:1.5rem;color:var(--accent)}
+.results .card h3{margin:0}
+
+/* --- testimonials --- */
+.testimonials .card.quote{display:flex;flex-direction:column;gap:12px}
+.avatar{border-radius:50%;object-fit:cover;background:#eee}
+.avatar.lg{width:72px;height:72px;margin:0 auto 16px;display:block}
+blockquote{margin:0;font-style:italic;color:var(--fg)}
+.quote figcaption{display:flex;flex-direction:column;font-style:normal;font-family:"Trebuchet MS",sans-serif}
+.quote figcaption span{color:var(--muted);font-size:.85rem}
+
+/* --- founder note --- */
+.founder{text-align:center;background:#f3efe6}
+.founder .sign{font-weight:700;color:var(--ink)}
+
+/* --- package pricing/timeline --- */
+.price-range{font-family:"Trebuchet MS",sans-serif;font-weight:800;font-size:1.15rem;margin:6px 0 2px}
+.timeline{color:var(--muted);font-size:.85rem;margin:0 0 14px}
+
+/* --- lead magnet --- */
+.magnet{background:var(--ink);color:#fff}
+.magnet-in{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:center}
+@media(max-width:760px){.magnet-in{grid-template-columns:1fr}}
+.magnet .lead{color:#dbe6ee}
+.magnet-form{display:flex;flex-direction:column;gap:12px;color:var(--fg)}
+.magnet-form .note{margin:0;font-size:.85rem;color:#1faa59}
+.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
+
+/* --- footer additions --- */
+.foot{align-items:flex-start}
+.foot-col{display:flex;flex-direction:column;gap:4px}
+.foot-links{flex-direction:row;gap:16px}
+.foot-links a{color:var(--muted);text-decoration:none}
+.foot-links a:hover{color:var(--fg)}
+.fine{font-size:.78rem;opacity:.75}
+
+/* --- simple static legal pages --- */
+.legal{padding:64px 0 90px}
+.legal h1{font-size:clamp(1.8rem,4vw,2.6rem);margin:0 0 6px}
+.legal .updated{color:var(--muted);font-size:.85rem;margin:0 0 34px}
+.legal h2{font-size:1.2rem;margin:32px 0 8px}
+.legal p,.legal li{color:var(--muted)}
