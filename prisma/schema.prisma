generator client {
  provider = "prisma-client-js"
}

datasource db {
  url      = env("DATABASE_URL")
  provider = "postgresql"
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  business  String
  service   String   @default("")
  message   String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now())
}
